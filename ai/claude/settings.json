{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_AUTOUPDATER": "true"
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Bash(jj git remote list:*)",
      "Bash(jj workspace update-stale)",
      "Bash(jj file show:*)",
      "Bash(jj show:*)",
      "Bash(jj diff:*)",
      "Bash(jj log:*)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notification-say.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/notification-tmux.sh"
          }
        ]
      }
    ]
  },
  "model": "claude-opus-4-5"
}
